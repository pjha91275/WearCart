      "boundElements": [],
      "updated": 1766127383223,
      "link": null,
      "locked": false,
      "text": "For Sign up Page,\nCeate a 'portal user' database into the system on signup\nCheck creds as follows\n1. Email Id should not be a duplicate in database\n2.Password must me unique and must contain a small case, a large case and \na special character and length should be in more then 8 charachters. ",
      "fontSize": 11.6063494001116,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For Sign up Page,\nCeate a 'portal user' database into the system on signup\nCheck creds as follows\n1. Email Id should not be a duplicate in database\n2.Password must me unique and must contain a small case, a large case and \na special character and length should be in more then 8 charachters. ",
      "autoResize": true,
      "lineHeight": 1.25
